q-component rpCard {
  q-logger { q-property }
  q-property rank: "2"
  q-property suit: "D"
  q-property cardId: "2D"
  q-property currentSlot: 1
  q-property cardFrom: 0vh
  q-property cardTo: 0vh
  q-property cardDuration: 3000
  q-property isSpinning: false
  q-property cardTop: 0vh

  q-signal cardSpinCycleEnded(reelNumber, slotIndex, cardId)

  function getSource() {
    return "cards/" + this.rank + this.suit + ".svg";
  }

  function updateImageSource() {
    this.cardId = this.rank + this.suit;
    this.querySelector("img").setAttribute("src", this.getSource());
    this.querySelector("img").setAttribute("alt", this.cardId);
  }

  function setCard(rank, suit) {
    this.rank = String(rank);
    this.suit = String(suit);
    this.updateImageSource();
  }

  function syncSpinAnimation() {
    this.spinAnimation.from = this.cardFrom;
    this.spinAnimation.to = this.cardTo;
    this.spinAnimation.duration = this.cardDuration;
  }

  function prepareSpin(fromValue, toValue, duration) {
    this.cardFrom = String(fromValue);
    this.cardTo = String(toValue);
    this.cardDuration = duration;
    this.top = this.cardFrom;
    this.syncSpinAnimation();
  }

  function startSpin() {
    this.isSpinning = true;
    this.top = this.cardFrom;
    this.syncSpinAnimation();
    this.spinAnimation.start();
  }

  function stopSpin() {
    this.isSpinning = false;
  }

  onrankchanged(val) {
    this.updateImageSource();
  }

  onsuitchanged(val) {
    this.updateImageSource();
  }

  oncardFromChanged(val) {
    this.spinAnimation.from = val;
  }
  oncardTopChanged(val) {
   this.style.top = val;
  }
  oncardToChanged(val) {
    this.spinAnimation.to = val;
  }

  oncardDurationChanged(val) {

    this.spinAnimation.duration = val;
  }

  onready {
    this.updateImageSource();
    this.syncSpinAnimation();
  }

  q-style rpCardHostStyle {
    position: absolute;
    width: 13.82vw;
    height: 16.9167vh;
    display: grid;
    placeItems: center;
    boxSizing: border-box;
    pointerEvents: none;
    margin: 0;
    padding: 0;
    overflow: visible;
  }

  q-style rpCardImageStyle {
    display: block;
    width: min(13.82vw, 11.65vh);
    height: min(16.9167vh, 20.07vw);
    maxWidth: 13.82vw;
    maxHeight: 16.9167vh;
    objectFit: contain;
    boxSizing: border-box;
    margin: auto;
    pointerEvents: none;
  }

  q-theme rpCardTheme {
    img.rp-card-image { rpCardImageStyle }
  }

  q-property-animation spinAnimation {
    target: this
    property: "cardTop"
    from: 0vh
    to: 100vh
    steps: 30
    duration: 3000
    running: false
    onended {
      this.cardSpinCycleEnded(0, this.currentSlot, this.cardId);
    }
  }

  rpCardTheme {
    img.rp-card-image {
      src: "cards/2D.svg"
      alt: "2D"
      draggable: false
    }
  }
}
